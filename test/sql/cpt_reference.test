# name: test/sql/cpt_reference.test
# description: reference datasets against R changepoint 2.3 (exported by tools/export_reference.R)
# Run from the root of duck-changepoint-reference: make test CPT_EXTENSION=<path to cpt.duckdb_extension>
# group: [cpt]

require cpt

require json

# --- Nile (datasets::Nile): one change in mean after 1898 (position 28) ------------------------

statement ok
CREATE TABLE nile AS SELECT * FROM read_csv('test/data/nile.csv');

statement ok
CREATE TABLE nile_expected AS
SELECT r."function" AS fn, r.penalty, r.bkps
FROM (SELECT unnest(results) AS r FROM read_json('test/data/expected_nile.json'));

# changepoint's cpt.mean assumes unit variance, so the series is scaled by its sd (as for R)
query II
SELECT cpt_pelt(list(flow / sd ORDER BY year), 'l2', 'bic'), cpt_pelt(list(flow / sd ORDER BY year), 'l2', 'mbic')
FROM nile, (SELECT stddev_samp(flow) AS sd FROM nile)
----
[28, 100]	[28, 100]

query II
SELECT e.penalty, cpt_pelt(list(flow / sd ORDER BY year), 'l2', lower(e.penalty)) = e.bkps
FROM nile, (SELECT stddev_samp(flow) AS sd FROM nile), nile_expected e
WHERE e.fn = 'cpt.mean' GROUP BY e.penalty, e.bkps ORDER BY e.penalty
----
BIC	true
MBIC	true

query II
SELECT e.penalty, cpt_pelt(list(flow ORDER BY year), 'normal', lower(e.penalty)) = e.bkps
FROM nile, nile_expected e
WHERE e.fn = 'cpt.meanvar' GROUP BY e.penalty, e.bkps ORDER BY e.penalty
----
BIC	true
MBIC	true

# changing mean and variance also isolates the tight run of 1871-1876 (as changepoint does)
query I
SELECT cpt_pelt(list(flow ORDER BY year), 'normal', 'mbic') FROM nile
----
[4, 6, 28, 100]

# --- Lai2005fig4 (aCGH): column 5 (GBM29) as in the changepoint vignette -----------------------

query II
WITH x AS (SELECT list(GBM29 ORDER BY rn) AS xs
           FROM (SELECT row_number() OVER () AS rn, GBM29 FROM read_csv('test/data/lai2005fig4.csv'))),
e AS (SELECT unnest(results) AS r FROM read_json('test/data/expected_lai2005fig4.json'))
SELECT r.penalty, cpt_pelt(xs, 'l2', lower(r.penalty)) = r.bkps FROM x, e ORDER BY r.penalty
----
BIC	true
MBIC	true

query I
SELECT cpt_pelt(list(GBM29 ORDER BY rn), 'l2', 'mbic')
FROM (SELECT row_number() OVER () AS rn, GBM29 FROM read_csv('test/data/lai2005fig4.csv'))
----
[81, 85, 89, 96, 123, 133, 193]

# --- wave.c44137 and ftse100: changing mean and variance ---------------------------------------
#
# On these two series changepoint's PELT returns segmentations that are not optimal: it prunes
# without regard to minseglen (2 for cpt.meanvar), and Optimal Partitioning without pruning finds a
# strictly lower penalised cost (see test/python/check_optimality.py). cpt's result must therefore be
# at least as good as changepoint's, evaluated with the same cost, penalty and 1e-11 variance floor.

statement ok
CREATE MACRO normal_objective(xs, bkps, beta, mbic) AS (
    SELECT sum(st.n * ln(greatest(coalesce(st.var, 0) * (st.n - 1) / st.n, 1e-11))
               + CASE WHEN mbic THEN ln(st.n) ELSE 0 END) + beta * (len(bkps) - 1)
    FROM (SELECT unnest(cpt_segment_stats(xs, bkps)) AS st)
);

statement ok
CREATE TABLE meanvar_cases AS
WITH wave AS (SELECT list(height ORDER BY t) AS xs FROM read_csv('test/data/wave_c44137.csv')),
ftse AS (SELECT list(V2 ORDER BY rn) AS xs
         FROM (SELECT row_number() OVER () AS rn, V2 FROM read_csv('test/data/ftse100.csv')))
SELECT 'wave_c44137' AS dataset, r.penalty, r.pen_value, r.bkps AS expected, xs
FROM wave, (SELECT unnest(results) AS r FROM read_json('test/data/expected_wave_c44137.json'))
UNION ALL
SELECT 'ftse100', r.penalty, r.pen_value, r.bkps, xs
FROM ftse, (SELECT unnest(results) AS r FROM read_json('test/data/expected_ftse100.json'));

query IIII
SELECT dataset, penalty,
       normal_objective(xs, cpt_pelt(xs, 'normal', lower(penalty)), pen_value, penalty = 'MBIC')
         <= normal_objective(xs, expected, pen_value, penalty = 'MBIC') + 1e-6,
       -- the two answers still agree on most change points
       len(list_intersect(cpt_pelt(xs, 'normal', lower(penalty)), expected)) >= 0.8 * len(expected)
FROM meanvar_cases ORDER BY dataset, penalty
----
ftse100	BIC	true	true
ftse100	MBIC	true	true
wave_c44137	BIC	true	true
wave_c44137	MBIC	true	true

query I
SELECT cpt_pelt(xs, 'normal', 'mbic') FROM meanvar_cases WHERE dataset = 'ftse100' AND penalty = 'MBIC'
----
[892, 913, 1641, 1648, 2134, 2145, 2783, 3273, 4594, 4840, 5884, 6169, 6319, 6905, 6990, 7187]
